@{
}

<table class="table">
    <thead>
        <tr>
            <th>Donor ID</th>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Contact Number</th>
            <th>City</th>
            <th>Last Donated Date</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.DonorId</td>
            <td>@Model.FullName</td>
            <td>@Model.BloodGroup</td>
            <td>@Model.ContactNo</td>
            <td>@Model.City</td>
            <td>@Model.LastDonationDate</td>
        </tr>
    </tbody>
</table>

<form method="post">
    <input type="hidden" name="DonorId" value="@Model.DonorId" />
    <input type="submit" name="flag" value="yes" class="btn btn-success"/>
    <input type="submit" name="flag" value="no" class="btn btn-danger" />
</form>